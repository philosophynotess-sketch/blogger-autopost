# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Blogger OAuth
G_CLIENT_ID=
G_CLIENT_SECRET=
G_REFRESH_TOKEN=
BLOGGER_BLOG_ID=

# Optional: fortune app promo (leave APP_URL empty while building the app)
APP_NAME=운세 인사이트
APP_URL=

# Optional: SEO thumbnail pipeline
HF_TOKEN=
IMGBB_API_KEY=

# Optional: Coupang Partners (leave URL empty to hide block)
# Use a partners deep link or search/category URL from partners.coupang.com
COUPANG_PARTNERS_URL=
COUPANG_TITLE=오늘의 운세 루틴에 어울리는 아이템
COUPANG_DESCRIPTION=타로·다이어리·감성 소품 등, 아침 루틴에 가볍게 곁들이기 좋은 상품을 모았습니다.
# Optional banner image URL (hosted image). Empty = text+button only
COUPANG_BANNER_URL=

# Local testing
# DRY_RUN=1
# FORCE_CATEGORY=daily_overview
