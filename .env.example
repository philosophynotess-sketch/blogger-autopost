# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Blogger OAuth
G_CLIENT_ID=
G_CLIENT_SECRET=
G_REFRESH_TOKEN=
BLOGGER_BLOG_ID=

# Optional: fortune app promo (leave APP_URL empty while building the app)
APP_NAME=운세 인사이트
APP_URL=

# Optional: SEO thumbnail pipeline
HF_TOKEN=
IMGBB_API_KEY=

# Coupang Partners: default rotation is content/coupang_links.json
# Optional override (if set, always uses this single URL instead of rotation)
COUPANG_PARTNERS_URL=
COUPANG_TITLE=오늘의 운세 루틴에 어울리는 아이템
COUPANG_DESCRIPTION=타로·다이어리·감성 소품 등, 아침 루틴에 가볍게 곁들이기 좋은 상품을 모았습니다.
COUPANG_BANNER_URL=

# Character pack (see docs/brand/characters/options/)
# CHARACTER_PACK=option-01-candy

# Meta social (optional — Phase 1)
# META_PUBLISH=0
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=
# IG_USER_ID=

# Local testing
# DRY_RUN=1
# FORCE_CATEGORY=daily_overview
